      <section_4 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" style="[beige]" model="section" modelFields="[name,style,anchor]">
        <columns sling:resourceType="core/franklin/components/columns/v1/columns" jcr:primaryType="nt:unstructured" classes="image top" rows="1" columns="2">
          <row1 jcr:primaryType="nt:unstructured">
            <col1 jcr:primaryType="nt:unstructured">
              <image sling:resourceType="core/franklin/components/image/v1/image" jcr:primaryType="nt:unstructured" image="/content/dam/luxtravelcf/images/amalfi-coast/artisan-at-work.png" imageAlt="Traditional artisan at work"/>
            </col1>
            <col2 jcr:primaryType="nt:unstructured">
              <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;Local Legacies&lt;/p&gt;"/>
              <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Connect with the guardians of traditional heritage." titleType="h2"/>
              <text_1 sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;Wander into centuries of living artistry. We arrange
                    private, one-on-one sessions in legacy family ateliers.
                    Learn the intricate art of majolica pottery glazing from
                    master ceramists, explore the local coastal fish markets
                    with top-rated regional chefs, or join a resident
                    botanist in a private lemon garden harvest to uncover the
                    sacred recipe of Amalfi&#x27;s beloved gold elixir.&lt;/p&gt;"/>
            </col2>
          </row1>
        </columns>
      </section_4>
      <section_5 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" style="[centered]" model="section" modelFields="[name,style,anchor]">
