        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Fluidity to Match Your Pace" titleType="h2"/>
        <text_1 sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;A true luxury itinerary is never a static document. Whether prompted by sudden weather shifts, a fleeting seasonal harvest festival, or simply a spontaneous change of heart, your travel plan shifts effortlessly.&lt;/p&gt;"/>
